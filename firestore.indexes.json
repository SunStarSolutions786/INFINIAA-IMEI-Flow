{
  "//": "Composite indexes for the on-demand queries. The app degrades gracefully until these exist (log views fall back to an unsorted page; stock counts fall back to 0), so it runs before they finish building. Deploy with: firebase deploy --only firestore:indexes",
  "indexes": [
    {
      "//": "serialStockCount(modelId, stockStatus) - live availability without loading inventory",
      "collectionGroup": "inventory",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "modelId", "order": "ASCENDING" },
        { "fieldPath": "stockStatus", "order": "ASCENDING" }
      ]
    },
    {
      "//": "product price history drawer",
      "collectionGroup": "priceLogs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "modelId", "order": "ASCENDING" },
        { "fieldPath": "changedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "quantity stock movement drawer",
      "collectionGroup": "stockMovements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "modelId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
